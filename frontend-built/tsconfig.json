{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@ch2/ai-assistant/*": ["../shared/ai-assistant/*"],
      "@ch2/macro-shell/*": ["../shared/macro-shell/*"],
      "@ch2/stats-glossary": ["../shared/stats-glossary/index.ts"],
      "@ch2/stats-glossary/*": ["../shared/stats-glossary/*"],
      "@ch2/analysis-help": ["../shared/analysis-help/index.ts"],
      "@ch2/analysis-help/*": ["../shared/analysis-help/*"],
      "@ch2/model-recommend": ["../shared/model-recommend/index.ts"],
      "@ch2/model-recommend/*": ["../shared/model-recommend/*"]
    }
  },
  "include": ["src"]
}
