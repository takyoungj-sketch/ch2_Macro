[Unit]
Description=CH2 DATA unified bulletin board (Node)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ch2_Macro/deploy/board
Environment=NODE_ENV=production
Environment=PORT=5180
EnvironmentFile=-/opt/ch2_Macro/deploy/.env.production
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
