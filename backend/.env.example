DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/land_stats
# BUILT_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/built_stats
# COLLECTIVE_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/collective_stats
# RENT_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/rent_stats
SECRET_KEY=change_me_to_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:5178,http://localhost:3000

# DECISIONS D-007: 결제·로그인 도입 전 1단 보호용 토큰.
# 값이 있으면 모든 비-/health 요청이 `X-Api-Token: <값>` 헤더를 가져야 통과한다.
# 비어 있으면 미들웨어는 비활성 (개발/로컬 모드).
# API_TOKEN=

# 관리자 QA 검증 API (/api/admin/qa/*). 비어 있으면 로컬처럼 통과(API_TOKEN과 동일).
# 값이 있으면 헤더 X-Qa-Audit-Token 필요. CLI는 토큰 없이 로컬 DB만 사용.
# QA_AUDIT_TOKEN=

# CH2 AI Assistant (optional — 없으면 템플릿·Explain presets 모드)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# AI_POLISH_ENABLED=false
# AI_CASUAL_DIALOGUE_ENABLED=true
# AI_OPEN_MODE=false
# TAVILY_API_KEY=tvly-...
# AI_SESSION_TTL_SECONDS=86400
# AI_RATE_LIMIT_PER_MINUTE=30

# 무료 V2 API: 요청에 as_of_month 없을 때만 사용. 값이 있으면 그 달(1일)로 고정(월간 재생 후에도 과거 고정이라 일반 로컬·운영에선 두지 않는 것을 권장).
# 비우거나 이 줄을 제거하면 STATS_V2_ASSUMED_TODAY(있으면) 또는 실제 «오늘» 기준 직전 달 1일(§3).
# STATS_V2_DEFAULT_AS_OF_MONTH=2026-04-01

# 단기 검증 전용 — «실제 오늘» 대신 기준 날짜를 박음. 과거 회귀 테스트용이고, 검증 후 제거해야 최신 배치 스냅샷(as_of 직전 달)과 UI가 함께 간다.
# STATS_V2_DEFAULT_AS_OF_MONTH 가 있으면 이 값은 무시됩니다.
# STATS_V2_ASSUMED_TODAY=2026-01-01

# 프론트(Vite): 무료 V2 에 as_of_month 를 쿼리로 강제·검증할 때만 동일 패턴 사용. 평소 비우고 백엔드와 백업한다.
# VITE_STATS_V2_ASSUMED_TODAY=2026-01-01

# FieldNote AI 프록시·device quota (ch2data.com/api/platform/fieldnote/ai)
# FIELDNOTE_AI_MONTHLY_QUOTA=50

# CH2 Platform — 통합 회원·게시판·구독 (별도 DB ch2_platform)
# DATABASE_URL_PLATFORM=postgresql+psycopg2://ch2app:password@localhost:5432/ch2_platform
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://ch2data.com/api/auth/google/callback
# PLATFORM_COOKIE_DOMAIN=.ch2data.com
# TOSS_WEBHOOK_SECRET=
